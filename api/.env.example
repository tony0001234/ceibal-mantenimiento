# ============================================================================
#  Plantilla de variables de entorno del backend (api)
#  Copia este archivo como  .env  y completa TU usuario y TU contrasena.
#  El archivo .env NO debe subirse al repositorio.
# ============================================================================

# Cadena de conexion de MongoDB Atlas.
#  - Host real del cluster: ceibal-mantenimiento.8te39ap.mongodb.net
#  - Base de datos:         Ceibal-Mantenimiento   (va despues de .mongodb.net/)
# Reemplaza TU_USUARIO y TU_CONTRASENA por tus credenciales reales.
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_CONTRASENA@ceibal-mantenimiento.8te39ap.mongodb.net/Ceibal-Mantenimiento?retryWrites=true&w=majority&appName=Ceibal-Mantenimiento

# Clave secreta para firmar los tokens JWT (>=32 caracteres en produccion).
JWT_SECRET=coloca_aqui_una_clave_larga_y_secreta
JWT_EXPIRES=8h

# Puerto de la API.
PORT=3000

# Origen(es) del frontend autorizados para CORS (separa varios con coma).
FRONTEND_URL=http://localhost:5173
